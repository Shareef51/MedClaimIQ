{
  "version": "1.0",
  "construction": "deterministic",
  "max_traversal_depth": 5,
  "default_traversal_depth": 3,
  "max_edges_per_query": 100,
  "crosswalk": {
    "matched_threshold": 0.85,
    "review_threshold": 0.60,
    "code_weight": 0.55,
    "service_date_weight": 0.25,
    "amount_weight": 0.20
  },
  "source_authority": {
    "fhir_encounter": 95,
    "fhir_eob": 92,
    "fhir_coverage": 92,
    "policy_system": 90,
    "fhir_claim": 88,
    "accepted_original_evidence": 80,
    "structured_claim_db": 78,
    "derived_extraction": 68,
    "user_assertion": 45
  },
  "guardrails": {
    "cross_tenant_edges_forbidden": true,
    "self_edges_forbidden": true,
    "source_versions_immutable": true,
    "edge_history_immutable": true,
    "llm_authoritative_graph_writes": false,
    "contradiction_resolution_requires_human": true
  }
}
