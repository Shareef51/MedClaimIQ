{
  "prompt_version": "1.0.0",
  "default_model": "gpt-5.6-terra",
  "fallback_model": "gpt-5.6-luna",
  "structured_output_schema": "SpecialistAgentOutput",
  "evidence_only": true,
  "allowed_tools": ["evidence.list", "evidence.get", "evidence.search", "contradiction.list"],
  "prohibited_capabilities": ["final_claim_decision", "claim_state_mutation", "authorization_mutation", "tenant_switch", "arbitrary_sql", "network_egress", "filesystem_write", "payment_action"],
  "confidence": {"default_minimum": 0.55, "high_risk_minimum": 0.60},
  "retry": {"delegated_to_orchestration_retry_policy": true, "contract_violation_retryable": false}
}
