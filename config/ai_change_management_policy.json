{
  "policy_id": "medclaimiq.ai-change-management.v1",
  "promotion": {
    "production_requires_passing_evaluation": true,
    "high_risk_requires_human_approval": true,
    "prevent_self_approval": true,
    "rollback_uses_previously_approved_snapshot": true,
    "mutable_in_place_configuration": false
  },
  "experiments": {
    "supported_modes": ["shadow", "ab", "champion_challenger"],
    "deterministic_bucket_count": 10000,
    "max_challenger_basis_points": 5000,
    "production_non_shadow_requires_separate_approval": true,
    "raw_subject_identifiers_persisted": false,
    "shadow_output_can_drive_claim_decision": false
  },
  "quality_guardrails": {
    "quality_floor": 0.90,
    "max_quality_regression": 0.01,
    "max_latency_regression_fraction": 0.20,
    "max_cost_regression_fraction": 0.25
  },
  "drift_detection": {
    "enabled": true,
    "comparison": "canonical-payload-sha256",
    "production_drift_blocks_release": true
  },
  "configuration": {
    "secret_keys_allowed": false,
    "runtime_phi_allowed": false,
    "snapshot_hash": "sha256-canonical-json"
  }
}
