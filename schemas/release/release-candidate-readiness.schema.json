{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedClaimIQ Release Candidate Readiness",
  "type": "object",
  "required": [
    "release_id",
    "gates",
    "evidence_refs",
    "release_manifest_ref"
  ],
  "properties": {
    "release_id": {
      "type": "string"
    },
    "gates": {
      "type": "object"
    },
    "quality_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "release_manifest_ref": {
      "type": "string"
    }
  }
}