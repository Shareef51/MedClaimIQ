APP_ENV=local
DATABASE_URL=postgresql+psycopg://medclaimiq:medclaimiq@localhost:5432/medclaimiq
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=medclaimiq
S3_ACCESS_KEY=medclaimiq
S3_SECRET_KEY=change-me-local-only
S3_USE_DEFAULT_CREDENTIAL_CHAIN=false

# Secure evidence ingestion and S3/MinIO quarantine storage.
S3_REGION=us-east-1
S3_SERVER_SIDE_ENCRYPTION=
S3_SSE_KMS_KEY_ID=
UPLOAD_PRESIGN_TTL_SECONDS=900
UPLOAD_MAX_FILE_BYTES=524288000
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
MALWARE_SCAN_REQUIRED=true

# OIDC resource-server authentication. Configure these for your enterprise IdP.
OIDC_ISSUER_URL=https://identity.example.com/realms/medclaimiq
OIDC_AUDIENCE=medclaimiq-api
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_REQUIRED_SCOPES=medclaimiq.api
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_ALLOW_INSECURE_HTTP=false
AUTH_TENANT_HEADER=X-Tenant-Id
AUTH_SESSION_REQUIRED=true
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_ENFORCE_CLIENT_BINDING=false
AUTH_SESSION_HMAC_SECRET=replace-with-at-least-32-random-characters-from-a-secret-manager

# Document intelligence
DOCUMENT_PIPELINE_VERSION=document-intelligence-v1
DOCUMENT_PARSER_TIMEOUT_SECONDS=120
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
DOCUMENT_EXTRACTION_RETRY_BASE_SECONDS=15
DOCUMENT_EXTRACTION_RETRY_MAX_SECONDS=300

# FHIR / SMART integration (synthetic defaults only)
FHIR_DEFAULT_BASE_URL=http://localhost:8000/mock-fhir
FHIR_EXPECTED_VERSION=4.0.1
FHIR_HTTP_TIMEOUT_SECONDS=10
FHIR_MAX_ATTEMPTS=3
FHIR_RATE_LIMIT_PER_SECOND=10
SMART_TOKEN_URL=https://identity.example.invalid/oauth2/token
SMART_CLIENT_ID=medclaimiq-fhir-gateway
SMART_KEY_ID=configure-in-secret-manager
SMART_SCOPES=system/*.read
# SMART private key material must come from a secret manager; never commit it.

# Multi-RAG / embeddings / Qdrant
OPENAI_API_KEY=replace-with-secret-manager-reference
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_CACHE_TTL_SECONDS=604800
RAG_PARENT_CHUNK_TOKENS=1200
RAG_CHILD_CHUNK_TOKENS=350
RAG_CHUNK_OVERLAP_TOKENS=60
RAG_INDEX_VERSION=rag-v2-hybrid
RAG_INDEX_MAX_ATTEMPTS=3
RAG_RRF_K=60
RAG_CANDIDATE_MULTIPLIER=4
RAG_MINIMUM_RETRIEVAL_CONFIDENCE=0.35
RAG_DEFAULT_MINIMUM_AUTHORITY_RANK=0
CROSS_SOURCE_GRAPH_MAX_DEPTH=3
CROSS_SOURCE_GRAPH_MAX_EDGES=100
CROSS_SOURCE_EVIDENCE_PACK_LIMIT=20
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=medclaimiq
QDRANT_TIMEOUT_SECONDS=10

# RAG grounding guardrails
RAG_PROMPT_INJECTION_SUSPICIOUS_THRESHOLD=0.35
RAG_PROMPT_INJECTION_BLOCK_THRESHOLD=0.65
RAG_GUARDRAIL_MINIMUM_ITEM_CONFIDENCE=0.55
RAG_GUARDRAIL_MINIMUM_AUTHORITY_RANK=60
RAG_GUARDRAIL_MINIMUM_QUALITY_SCORE=0.50
RAG_GUARDRAIL_MINIMUM_PACK_COVERAGE=0.50
RAG_GUARDRAIL_MAX_REPAIRS=2

# Durable agent orchestration
AGENT_WORKFLOW_MAX_PARALLEL_AGENTS=8
AGENT_WORKFLOW_DEFAULT_MAX_ATTEMPTS=3
AGENT_WORKFLOW_RETRY_BASE_SECONDS=5
AGENT_WORKFLOW_RETRY_MAX_SECONDS=60
AGENT_WORKFLOW_DEFAULT_TIMEOUT_SECONDS=90
LANGGRAPH_STRICT_MSGPACK=true

# Specialist agents
AGENT_MODEL_NAME=gpt-5.6-terra
AGENT_FALLBACK_MODEL=gpt-5.6-luna
AGENT_PROMPT_VERSION=1.0.0
AI_CONFIG_REGISTRY_ENABLED=true
AI_CONFIG_REGISTRY_REQUIRED=false
AI_CONFIG_BUNDLE_KEY=agents.default
AGENT_FALLBACK_MODEL=gpt-5.6-luna
AGENT_PROMPT_VERSION=1.0.0
AGENT_MODEL_TIMEOUT_SECONDS=90

# MCP tool control plane
MCP_PROTOCOL_VERSION=2026-07-28
MCP_TOOL_TIMEOUT_SECONDS=10
MCP_READ_MAX_ATTEMPTS=2
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_RECOVERY_SECONDS=30
MCP_APPROVAL_TTL_MINUTES=30

# Real-time Kafka API / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CLIENT_ID=medclaimiq
EVENT_OUTBOX_BATCH_SIZE=100
EVENT_OUTBOX_POLL_SECONDS=0.5
EVENT_OUTBOX_MAX_ATTEMPTS=10
EVENT_RETRY_BASE_SECONDS=5
EVENT_CONSUMER_MAX_ATTEMPTS=3
EVENT_WORKER_MAX_INFLIGHT=32
EVENT_WORKER_PAUSE_THRESHOLD=24

FHIR_SUBSCRIPTION_WEBHOOK_SECRET=local-only-change-this-fhir-webhook-secret

# SLA / deadline engine
SLA_WORKER_BATCH_SIZE=100
SLA_WORKER_RECOVERY_BATCH_SIZE=500
SLA_WORKER_MAX_ATTEMPTS=5
SLA_WORKER_RETRY_BASE_SECONDS=15
SLA_WORKER_RETRY_MAX_SECONDS=900
SLA_TIMER_POLL_SECONDS=1.0

# Reviewer web application / OIDC BFF
MEDCLAIMIQ_FRONTEND_ORIGIN=http://localhost:3000
MEDCLAIMIQ_BACKEND_URL=http://localhost:8000
MEDCLAIMIQ_DEFAULT_TENANT_ID=tenant-payer-demo
MEDCLAIMIQ_OIDC_ISSUER=https://identity.example.com/realms/medclaimiq
MEDCLAIMIQ_OIDC_CLIENT_ID=medclaimiq-reviewer-ui
MEDCLAIMIQ_OIDC_CLIENT_SECRET=replace-with-secret-manager-reference
MEDCLAIMIQ_OIDC_SCOPE=openid profile email offline_access medclaimiq.api
MEDCLAIMIQ_FRONTEND_SESSION_SECRET=replace-with-at-least-32-random-bytes-from-a-secret-manager

# LLMOps / OpenTelemetry (external exporters are opt-in)
OTEL_TRACE_SAMPLE_RATIO=0.10
OTEL_EXPORTER_OTLP_ENDPOINT=
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=medclaimiq
PHOENIX_API_KEY=
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_OTEL_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
LANGSMITH_PROJECT=medclaimiq
# Optional JSON, e.g. {"your-model":{"input_usd_per_million":1.0,"output_usd_per_million":2.0,"version":"provider-2026-08"}}
LLMOPS_MODEL_PRICING_JSON={}

# Security/privacy hardening
SECURITY_RATE_LIMIT_BACKEND=memory
SECURITY_RATE_LIMIT_REQUESTS_PER_MINUTE=120
SECURITY_RATE_LIMIT_MUTATIONS_PER_MINUTE=40
SECURITY_AUDIT_EXPORT_HMAC_SECRET=replace-with-at-least-32-random-bytes-from-a-secret-manager
SECURITY_KMS_KEY_ID=
SECURITY_SECRET_PROVIDER=environment
SECURITY_RETENTION_DEFAULT_DAYS=2555

# Cloud/Kubernetes runtime (production values are injected by Helm + CSI)
CLOUD_PROVIDER=local
KUBERNETES_CLUSTER_NAME=
DEPLOYMENT_REGION=
DR_RTO_TARGET_MINUTES=60
DR_RPO_TARGET_MINUTES=5

# Knowledge lifecycle / continuous RAG projection governance
KNOWLEDGE_REINDEX_POLL_SECONDS=2.0
KNOWLEDGE_STALE_SCAN_SECONDS=900

# Advanced Agentic RAG (model-assisted rewriting is opt-in; deterministic planning remains available)
RAG_ADVANCED_MODEL_ASSISTED_REWRITING_ENABLED=false
RAG_ADVANCED_QUERY_MODEL=gpt-5.6-terra
RAG_ADVANCED_MAX_REWRITES=5
RAG_ADVANCED_MAX_ROUNDS=2
RAG_ADVANCED_GAP_CONFIDENCE=0.55
RAG_ADVANCED_MIN_CITATION_COVERAGE=0.80
FINANCIAL_INTELLIGENCE_COPILOT_MODEL_ENABLED=false
FINANCIAL_INTELLIGENCE_COPILOT_MODEL=gpt-5.6-terra
REGULATORY_REMEDIATION_RECOMMENDATION_MODEL_ENABLED=false
REGULATORY_REMEDIATION_RECOMMENDATION_MODEL=gpt-5.6-terra
RAG_MULTIMODAL_MAX_CANDIDATES=60
RAG_MULTIMODAL_MINIMUM_CONFIDENCE=0.50
RAG_MULTIMODAL_MINIMUM_CITATION_COVERAGE=0.80

# Multimodal specialist orchestration
MULTIMODAL_AGENT_ORCHESTRATION_ENABLED=true
MULTIMODAL_AGENT_MAX_PACK_ITEMS=18

# Release 37 post-decision communications / compliance
COMMUNICATION_DESTINATION_ENCRYPTION_SECRET=replace-with-at-least-32-random-bytes-from-kms-or-secret-manager
COMMUNICATION_DESTINATION_KEY_VERSION=v1
COMMUNICATION_PROVIDER_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes-from-provider-secret-store
COMMUNICATION_WORKER_TOKEN=replace-with-at-least-32-random-bytes-from-workload-secret-store
COMMUNICATION_WORKER_LEASE_SECONDS=60
COMMUNICATION_WORKER_POLL_SECONDS=1.0
COMMUNICATION_MAX_DELIVERY_ATTEMPTS=5
COMMUNICATION_RETRY_BASE_SECONDS=30
COMMUNICATION_RETRY_MAX_SECONDS=3600
COMMUNICATION_RETENTION_DAYS=2555
COMMUNICATION_DELIVERY_SLO_PERCENT=99.0
