{
  "realm": "medclaimiq",
  "enabled": true,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "medclaimiq.api",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "medclaimiq-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "medclaimiq-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "medclaimiq-reviewer-ui",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/api/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access", "medclaimiq.api"]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "demo-reviewer",
      "email": "reviewer@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Reviewer",
      "credentials": [
        {"type": "password", "value": "DemoReviewer!2026", "temporary": false}
      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "demo-payer-admin",
      "email": "payer-admin@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "PayerAdmin",
      "credentials": [
        {"type": "password", "value": "DemoPayerAdmin!2026", "temporary": false}
      ]
    }
  ]
}
