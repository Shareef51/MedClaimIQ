# Browser origin used for OAuth callbacks and same-origin mutation checks.
MEDCLAIMIQ_FRONTEND_ORIGIN=http://localhost:3000

# FastAPI base URL, server-side only. Do not expose through NEXT_PUBLIC_*.
MEDCLAIMIQ_BACKEND_URL=http://localhost:8000

# Tenant selected for local synthetic demonstrations when no tenant is entered on login.
MEDCLAIMIQ_DEFAULT_TENANT_ID=tenant-payer-demo

# OIDC Authorization Code + PKCE configuration.
MEDCLAIMIQ_OIDC_ISSUER=https://identity.example.com
MEDCLAIMIQ_OIDC_CLIENT_ID=medclaimiq-reviewer-ui
MEDCLAIMIQ_OIDC_CLIENT_SECRET=
MEDCLAIMIQ_OIDC_SCOPE=openid profile email offline_access medclaimiq.api
MEDCLAIMIQ_OIDC_CLIENT_AUTH_METHOD=client_secret_post

# 32+ random bytes. Used to AES-GCM encrypt browser session cookies.
MEDCLAIMIQ_FRONTEND_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Synthetic portfolio demo. The application enforces non-production use even if this flag is set.
MEDCLAIMIQ_ALLOW_DEMO_SESSION=false
MEDCLAIMIQ_DEMO_TENANT_ID=tenant-payer-demo
MEDCLAIMIQ_DEMO_BEARER_TOKEN=
MEDCLAIMIQ_DEMO_REVIEWER_TOKEN=
MEDCLAIMIQ_DEMO_ADMIN_TOKEN=
MEDCLAIMIQ_DEMO_AUDITOR_TOKEN=
MEDCLAIMIQ_DEMO_FINANCE_TOKEN=
MEDCLAIMIQ_DEMO_PROVIDER_TOKEN=
MEDCLAIMIQ_DEMO_PATIENT_TOKEN=
